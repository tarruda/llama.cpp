#version 450

#extension GL_EXT_control_flow_attributes : enable
#extension GL_KHR_shader_subgroup_basic : require
#extension GL_KHR_shader_subgroup_arithmetic : require

#include "types.glsl"

layout(local_size_x_id = 0, local_size_y = 1, local_size_z = 1) in;
layout(constant_id = 1) const uint K_VECS_PER_WG = 8u;

layout(push_constant) uniform Parameters {
    uint n_kv;
    uint nb1;
    uint nb3;
    uint nb01;
    uint nb02;
    uint nb03;
    uint nb12;
    uint nb13;
    uint nb21;
    uint nb23;
    float scale_embd;
    float scale_heads;
} p;

layout(binding = 0) readonly  buffer QBuf { float data_q[]; };

layout(binding = 1) readonly buffer KBuf { A_TYPE data_a[]; };
#if defined(A_TYPE_PACKED16)
layout(binding = 1) readonly buffer KBufPacked16 { A_TYPE_PACKED16 data_a_packed16[]; };
#endif
#if defined(A_TYPE_PACKED32)
layout(binding = 1) readonly buffer KBufPacked32 { A_TYPE_PACKED32 data_a_packed32[]; };
#endif

layout(binding = 2) readonly  buffer WBuf   { float data_w[]; };
layout(binding = 3) writeonly buffer DstBuf { float data_dst[]; };

#include "dequant_funcs.glsl"

const uint N_EMBD = 128u;
const uint N_HEAD = 64u;

float load_k(const uint k_base, const uint i) {
#if defined(DATA_A_F32)
    return data_a[k_base + i];
#elif defined(DATA_A_F16)
    return float(data_a[k_base + i]);
#elif defined(DATA_A_BF16)
    return bf16_to_fp32(data_a[k_base + i]);
#else
    const uint ib = k_base + i / QUANT_K;
    const uint i_block = i % QUANT_K;
#if QUANT_R == 2
    const vec2 v = dequantize(ib, i_block % (QUANT_K/2u), 0u);
    const float raw = i_block < (QUANT_K/2u) ? v.x : v.y;
#else
    const uint iqs = i_block & ~1u;
    const vec2 v = dequantize(ib, iqs, 0u);
    const float raw = (i_block & 1u) == 0u ? v.x : v.y;
#endif
    const vec2 dm = get_dm(ib, 0u);
    return raw*dm.x + dm.y;
#endif
}

void main() {
    const uint i_kv_local = gl_SubgroupID;
    if (i_kv_local >= K_VECS_PER_WG) {
        return;
    }

    const uint i_kv = gl_WorkGroupID.x*K_VECS_PER_WG + i_kv_local;
    if (i_kv >= p.n_kv) {
        return;
    }

    const uint i_batch = gl_WorkGroupID.y;
    const uint i_stream = gl_WorkGroupID.z;
    const uint lane = gl_SubgroupInvocationID;
    const uint subgroup_size = gl_SubgroupSize;

    const uint q_base = i_batch*p.nb02 + i_stream*p.nb03;
    const uint k_base = i_kv*p.nb12 + i_stream*p.nb13;
    const uint w_base = i_batch*p.nb21 + i_stream*p.nb23;

    float score = 0.0f;

    [[unroll]] for (uint i_head = 0u; i_head < N_HEAD; ++i_head) {
        float partial = 0.0f;
        for (uint i = lane; i < N_EMBD; i += subgroup_size) {
            partial += data_q[q_base + i_head*p.nb01 + i] * load_k(k_base, i);
        }

        float qk = subgroupAdd(partial);
        if (lane == 0u) {
            qk *= p.scale_embd;
            score += max(qk, 0.0f) * data_w[w_base + i_head];
        }
    }

    if (lane == 0u) {
        data_dst[i_batch*p.nb1 + i_stream*p.nb3 + i_kv] = score * p.scale_heads;
    }
}
